<!-- H1 Humanoid: 19 actuated DOF (torso + legs + arms), geometry-only (no external meshes) -->
<mujoco>

  <contact>
    <exclude body1="pelvis"                    body2="left_hip_yaw_link"/>
    <exclude body1="pelvis"                    body2="right_hip_yaw_link"/>
    <exclude body1="pelvis"                    body2="torso_link"/>
    <exclude body1="left_hip_yaw_link"         body2="left_hip_roll_link"/>
    <exclude body1="left_hip_roll_link"        body2="left_hip_pitch_link"/>
    <exclude body1="left_hip_pitch_link"       body2="left_knee_link"/>
    <exclude body1="left_knee_link"            body2="left_ankle_link"/>
    <exclude body1="right_hip_yaw_link"        body2="right_hip_roll_link"/>
    <exclude body1="right_hip_roll_link"       body2="right_hip_pitch_link"/>
    <exclude body1="right_hip_pitch_link"      body2="right_knee_link"/>
    <exclude body1="right_knee_link"           body2="right_ankle_link"/>
    <exclude body1="torso_link"                body2="left_shoulder_pitch_link"/>
    <exclude body1="torso_link"                body2="right_shoulder_pitch_link"/>
    <exclude body1="left_shoulder_pitch_link"  body2="left_shoulder_roll_link"/>
    <exclude body1="left_shoulder_roll_link"   body2="left_shoulder_yaw_link"/>
    <exclude body1="left_shoulder_yaw_link"    body2="left_elbow_link"/>
    <exclude body1="right_shoulder_pitch_link" body2="right_shoulder_roll_link"/>
    <exclude body1="right_shoulder_roll_link"  body2="right_shoulder_yaw_link"/>
    <exclude body1="right_shoulder_yaw_link"   body2="right_elbow_link"/>
  </contact>

  <worldbody>
    <body name="pelvis" pos="0 0 1.0">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="capsule" size="0.09 0.1" euler="1.5708 0 0"
            mass="5.0" rgba="0.4 0.4 0.8 1" condim="1"/>
      <inertial pos="0 0 0" mass="5.0" diaginertia="0.05 0.05 0.03"/>

      <!-- TORSO -->
      <body name="torso_link" pos="0 0 0.1">
        <joint name="torso" type="hinge" axis="0 0 1" range="-2.35 2.35"
               damping="10" stiffness="0" armature="0.1"/>
        <geom name="torso_geom" type="capsule" size="0.1 0.22" euler="1.5708 0 0"
              pos="0 0 0.2" mass="10.0" rgba="0.3 0.3 0.7 1" condim="1"/>
        <inertial pos="0 0 0.2" mass="10.0" diaginertia="0.15 0.15 0.05"/>

        <body name="head" pos="0 0 0.52">
          <geom type="sphere" size="0.12" mass="1.5" rgba="0.5 0.5 0.8 1" condim="1"/>
        </body>

        <!-- LEFT ARM -->
        <body name="left_shoulder_pitch_link" pos="0 0.2 0.37">
          <joint name="left_shoulder_pitch" type="hinge" axis="0 1 0"
                 range="-3.14 3.14" damping="5" stiffness="0" armature="0.05"/>
          <geom type="capsule" size="0.04 0.05" mass="1.5" rgba="0.35 0.35 0.75 1" condim="1"/>
          <inertial pos="0 0 0" mass="1.5" diaginertia="0.005 0.005 0.003"/>

          <body name="left_shoulder_roll_link" pos="0 0.05 0">
            <joint name="left_shoulder_roll" type="hinge" axis="1 0 0"
                   range="-1.57 3.14" damping="5" stiffness="0" armature="0.05"/>
            <geom type="capsule" size="0.035 0.05" mass="0.8" rgba="0.35 0.35 0.75 1" condim="1"/>
            <inertial pos="0 0 0" mass="0.8" diaginertia="0.003 0.003 0.002"/>

            <body name="left_shoulder_yaw_link" pos="0 0.05 0">
              <joint name="left_shoulder_yaw" type="hinge" axis="0 0 1"
                     range="-1.57 1.57" damping="5" stiffness="0" armature="0.05"/>
              <geom type="capsule" size="0.03 0.12" euler="1.5708 0 0" pos="0 0.13 0"
                    mass="0.8" rgba="0.35 0.35 0.75 1" condim="1"/>
              <inertial pos="0 0.1 0" mass="0.8" diaginertia="0.01 0.01 0.001"/>

              <body name="left_elbow_link" pos="0 0.28 0">
                <joint name="left_elbow" type="hinge" axis="0 1 0"
                       range="-1.57 1.57" damping="3" stiffness="0" armature="0.05"/>
                <geom type="capsule" size="0.03 0.12" euler="1.5708 0 0" pos="0 0.13 0"
                      mass="0.6" rgba="0.35 0.35 0.75 1" condim="1"/>
                <inertial pos="0 0.1 0" mass="0.6" diaginertia="0.008 0.008 0.001"/>
                <site name="left_hand_site" pos="0 0.26 0" size="0.04" rgba="0 1 0 0.3"/>
                <geom name="left_hand" type="sphere" size="0.04" pos="0 0.27 0"
                      mass="0.3" rgba="0.6 0.5 0.4 1" condim="4" friction="1.5 0.02 0.01"/>
              </body>
            </body>
          </body>
        </body>

        <!-- RIGHT ARM -->
        <body name="right_shoulder_pitch_link" pos="0 -0.2 0.37">
          <joint name="right_shoulder_pitch" type="hinge" axis="0 1 0"
                 range="-3.14 3.14" damping="5" stiffness="0" armature="0.05"/>
          <geom type="capsule" size="0.04 0.05" mass="1.5" rgba="0.35 0.35 0.75 1" condim="1"/>
          <inertial pos="0 0 0" mass="1.5" diaginertia="0.005 0.005 0.003"/>

          <body name="right_shoulder_roll_link" pos="0 -0.05 0">
            <joint name="right_shoulder_roll" type="hinge" axis="1 0 0"
                   range="-3.14 1.57" damping="5" stiffness="0" armature="0.05"/>
            <geom type="capsule" size="0.035 0.05" mass="0.8" rgba="0.35 0.35 0.75 1" condim="1"/>
            <inertial pos="0 0 0" mass="0.8" diaginertia="0.003 0.003 0.002"/>

            <body name="right_shoulder_yaw_link" pos="0 -0.05 0">
              <joint name="right_shoulder_yaw" type="hinge" axis="0 0 1"
                     range="-1.57 1.57" damping="5" stiffness="0" armature="0.05"/>
              <geom type="capsule" size="0.03 0.12" euler="1.5708 0 0" pos="0 -0.13 0"
                    mass="0.8" rgba="0.35 0.35 0.75 1" condim="1"/>
              <inertial pos="0 -0.1 0" mass="0.8" diaginertia="0.01 0.01 0.001"/>

              <body name="right_elbow_link" pos="0 -0.28 0">
                <joint name="right_elbow" type="hinge" axis="0 1 0"
                       range="-1.57 1.57" damping="3" stiffness="0" armature="0.05"/>
                <geom type="capsule" size="0.03 0.12" euler="1.5708 0 0" pos="0 -0.13 0"
                      mass="0.6" rgba="0.35 0.35 0.75 1" condim="1"/>
                <inertial pos="0 -0.1 0" mass="0.6" diaginertia="0.008 0.008 0.001"/>
                <site name="right_hand_site" pos="0 -0.26 0" size="0.04" rgba="1 0 0 0.3"/>
                <geom name="right_hand" type="sphere" size="0.04" pos="0 -0.27 0"
                      mass="0.3" rgba="0.6 0.5 0.4 1" condim="4" friction="1.5 0.02 0.01"/>
              </body>
            </body>
          </body>
        </body>

      </body> <!-- torso_link -->

      <!-- LEFT LEG -->
      <body name="left_hip_yaw_link" pos="0 0.1 -0.07">
        <joint name="left_hip_yaw" type="hinge" axis="0 0 1"
               range="-0.43 0.43" damping="15" stiffness="0" armature="0.1"/>
        <geom type="sphere" size="0.06" mass="1.5" rgba="0.4 0.4 0.8 1" condim="1"/>
        <inertial pos="0 0 0" mass="1.5" diaginertia="0.004 0.004 0.004"/>

        <body name="left_hip_roll_link">
          <joint name="left_hip_roll" type="hinge" axis="1 0 0"
                 range="-0.43 0.43" damping="15" stiffness="0" armature="0.1"/>
          <geom type="sphere" size="0.055" mass="1.0" rgba="0.4 0.4 0.8 1" condim="1"/>
          <inertial pos="0 0 0" mass="1.0" diaginertia="0.003 0.003 0.003"/>

          <body name="left_hip_pitch_link">
            <joint name="left_hip_pitch" type="hinge" axis="0 1 0"
                   range="-1.57 1.57" damping="15" stiffness="0" armature="0.1"/>
            <geom type="capsule" size="0.055 0.2" euler="1.5708 0 0" pos="0 0 -0.2"
                  mass="5.0" rgba="0.4 0.4 0.8 1" condim="1"/>
            <inertial pos="0 0 -0.2" mass="5.0" diaginertia="0.08 0.08 0.01"/>

            <body name="left_knee_link" pos="0 0 -0.4">
              <joint name="left_knee" type="hinge" axis="0 1 0"
                     range="-0.26 2.35" damping="10" stiffness="0" armature="0.1"/>
              <geom type="capsule" size="0.05 0.2" euler="1.5708 0 0" pos="0 0 -0.2"
                    mass="3.5" rgba="0.35 0.35 0.75 1" condim="1"/>
              <inertial pos="0 0 -0.2" mass="3.5" diaginertia="0.05 0.05 0.008"/>

              <body name="left_ankle_link" pos="0 0 -0.4">
                <joint name="left_ankle_pitch" type="hinge" axis="0 1 0"
                       range="-0.87 0.52" damping="5" stiffness="0" armature="0.1"/>
                <joint name="left_ankle_roll" type="hinge" axis="1 0 0"
                       range="-0.26 0.26" damping="3" stiffness="0" armature="0.05"/>
                <geom name="left_foot_geom" type="box" size="0.12 0.06 0.02" pos="0.04 0 -0.04"
                      mass="1.5" rgba="0.2 0.2 0.6 1" condim="4" friction="0.9 0.02 0.01"/>
                <inertial pos="0 0 0" mass="1.5" diaginertia="0.01 0.005 0.012"/>
                <site name="left_foot_contact" pos="0 0 -0.06" size="0.01"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- RIGHT LEG -->
      <body name="right_hip_yaw_link" pos="0 -0.1 -0.07">
        <joint name="right_hip_yaw" type="hinge" axis="0 0 1"
               range="-0.43 0.43" damping="15" stiffness="0" armature="0.1"/>
        <geom type="sphere" size="0.06" mass="1.5" rgba="0.4 0.4 0.8 1" condim="1"/>
        <inertial pos="0 0 0" mass="1.5" diaginertia="0.004 0.004 0.004"/>

        <body name="right_hip_roll_link">
          <joint name="right_hip_roll" type="hinge" axis="1 0 0"
                 range="-0.43 0.43" damping="15" stiffness="0" armature="0.1"/>
          <geom type="sphere" size="0.055" mass="1.0" rgba="0.4 0.4 0.8 1" condim="1"/>
          <inertial pos="0 0 0" mass="1.0" diaginertia="0.003 0.003 0.003"/>

          <body name="right_hip_pitch_link">
            <joint name="right_hip_pitch" type="hinge" axis="0 1 0"
                   range="-1.57 1.57" damping="15" stiffness="0" armature="0.1"/>
            <geom type="capsule" size="0.055 0.2" euler="1.5708 0 0" pos="0 0 -0.2"
                  mass="5.0" rgba="0.4 0.4 0.8 1" condim="1"/>
            <inertial pos="0 0 -0.2" mass="5.0" diaginertia="0.08 0.08 0.01"/>

            <body name="right_knee_link" pos="0 0 -0.4">
              <joint name="right_knee" type="hinge" axis="0 1 0"
                     range="-0.26 2.35" damping="10" stiffness="0" armature="0.1"/>
              <geom type="capsule" size="0.05 0.2" euler="1.5708 0 0" pos="0 0 -0.2"
                    mass="3.5" rgba="0.35 0.35 0.75 1" condim="1"/>
              <inertial pos="0 0 -0.2" mass="3.5" diaginertia="0.05 0.05 0.008"/>

              <body name="right_ankle_link" pos="0 0 -0.4">
                <joint name="right_ankle_pitch" type="hinge" axis="0 1 0"
                       range="-0.87 0.52" damping="5" stiffness="0" armature="0.1"/>
                <joint name="right_ankle_roll" type="hinge" axis="1 0 0"
                       range="-0.26 0.26" damping="3" stiffness="0" armature="0.05"/>
                <geom name="right_foot_geom" type="box" size="0.12 0.06 0.02" pos="0.04 0 -0.04"
                      mass="1.5" rgba="0.2 0.2 0.6 1" condim="4" friction="0.9 0.02 0.01"/>
                <inertial pos="0 0 0" mass="1.5" diaginertia="0.01 0.005 0.012"/>
                <site name="right_foot_contact" pos="0 0 -0.06" size="0.01"/>
              </body>
            </body>
          </body>
        </body>
      </body>

    </body> <!-- pelvis -->
  </worldbody>

  <actuator>
    <!-- Gains and force limits scaled for ~47 kg humanoid body mass -->
    <position name="torso"                joint="torso"                kp="400"  kv="40"  forcerange="-400  400"/>
    <position name="left_hip_yaw"         joint="left_hip_yaw"         kp="400"  kv="40"  forcerange="-400  400"/>
    <position name="left_hip_roll"        joint="left_hip_roll"        kp="400"  kv="40"  forcerange="-400  400"/>
    <position name="left_hip_pitch"       joint="left_hip_pitch"       kp="600"  kv="60"  forcerange="-600  600"/>
    <position name="left_knee"            joint="left_knee"            kp="600"  kv="60"  forcerange="-600  600"/>
    <position name="left_ankle_pitch"     joint="left_ankle_pitch"     kp="300"  kv="30"  forcerange="-300  300"/>
    <position name="left_ankle_roll"      joint="left_ankle_roll"      kp="150"  kv="15"  forcerange="-150  150"/>
    <position name="right_hip_yaw"        joint="right_hip_yaw"        kp="400"  kv="40"  forcerange="-400  400"/>
    <position name="right_hip_roll"       joint="right_hip_roll"       kp="400"  kv="40"  forcerange="-400  400"/>
    <position name="right_hip_pitch"      joint="right_hip_pitch"      kp="600"  kv="60"  forcerange="-600  600"/>
    <position name="right_knee"           joint="right_knee"           kp="600"  kv="60"  forcerange="-600  600"/>
    <position name="right_ankle_pitch"    joint="right_ankle_pitch"    kp="300"  kv="30"  forcerange="-300  300"/>
    <position name="right_ankle_roll"     joint="right_ankle_roll"     kp="150"  kv="15"  forcerange="-150  150"/>
    <position name="left_shoulder_pitch"  joint="left_shoulder_pitch"  kp="150"  kv="15"  forcerange="-150  150"/>
    <position name="left_shoulder_roll"   joint="left_shoulder_roll"   kp="150"  kv="15"  forcerange="-150  150"/>
    <position name="left_shoulder_yaw"    joint="left_shoulder_yaw"    kp="80"   kv="8"   forcerange="-80    80"/>
    <position name="left_elbow"           joint="left_elbow"           kp="100"  kv="10"  forcerange="-100  100"/>
    <position name="right_shoulder_pitch" joint="right_shoulder_pitch" kp="150"  kv="15"  forcerange="-150  150"/>
    <position name="right_shoulder_roll"  joint="right_shoulder_roll"  kp="150"  kv="15"  forcerange="-150  150"/>
    <position name="right_shoulder_yaw"   joint="right_shoulder_yaw"   kp="80"   kv="8"   forcerange="-80    80"/>
    <position name="right_elbow"          joint="right_elbow"          kp="100"  kv="10"  forcerange="-100  100"/>
  </actuator>

</mujoco>
